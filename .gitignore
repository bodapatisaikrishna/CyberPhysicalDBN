# Data — never commit dataset files (CLAUDE.md code standards)
data/*
!data/.gitkeep

# Results — raw per-run CSVs stay local; summaries are committed.
# The re-include for summaries must come AFTER the broad ignores and must
# name the FILES, not just the directory: `!results/summaries/` alone only
# re-includes the directory, and `results/**/*.csv` still matches the CSVs
# inside it, so summaries were being silently ignored.
results/*.csv
results/**/*.csv
!results/summaries/
!results/summaries/*.csv
!results/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/

# Model checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/

# OS
.DS_Store
